{
  "name": "raizstore",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "db:generate": "npm run prisma:generate --workspace=@raizstore/api",
    "db:migrate": "npm run prisma:migrate --workspace=@raizstore/api",
    "db:seed": "npm run prisma:seed --workspace=@raizstore/api",
    "db:studio": "npm run prisma:studio --workspace=@raizstore/api"
  },
  "dependencies": {
    "js-yaml": "5.2.2"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.2"
    },
    "next": {
      "postcss": "8.5.25"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0"
}
